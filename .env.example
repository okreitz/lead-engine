# Instance settings. Copy to .env for local overrides; never commit real secrets.
LE_HOST=127.0.0.1
LE_WEB_PORT=4500
LE_ENGINE_PORT=4501
LE_COLLECTOR_PORT=4511
# Relative paths resolve from apps/engine (where pnpm runs the engine).
LE_DB_PATH=../../data/le.db
# 32 bytes, base64 (`openssl rand -base64 32`). Encrypts workspace provider keys.
LE_MASTER_KEY=
# Needed to create the first user when the engine binds a non-loopback interface (Docker/VPS).
LE_SETUP_TOKEN=
# Session cookie Secure flag: auto (when the request came over HTTPS), true or false.
LE_COOKIE_SECURE=auto
# Optional instance fallback for the anthropic-api LLM adapter (workspace keys win).
ANTHROPIC_API_KEY=
# Where the web app's /api/v1 proxy reaches the engine.
LE_ENGINE_URL=http://127.0.0.1:4501
