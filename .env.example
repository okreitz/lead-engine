# Instance settings. Copy to .env for local overrides; never commit real secrets.
LE_HOST=127.0.0.1
LE_WEB_PORT=4500
LE_ENGINE_PORT=4501
LE_COLLECTOR_PORT=4511
# Relative paths resolve from apps/engine (where pnpm runs the engine).
LE_DB_PATH=../../data/le.db
# 32-byte key, base64. Encrypts workspace provider keys (Phase 1).
LE_MASTER_KEY=
