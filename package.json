{
  "name": "lead-engine",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n web,engine -c cyan,magenta \"pnpm --filter @le/web dev\" \"pnpm --filter @le/engine dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @le/engine db:generate",
    "db:migrate": "pnpm --filter @le/engine db:migrate",
    "rss": "node scripts/rss.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
